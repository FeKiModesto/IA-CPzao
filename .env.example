# Chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=cole-sua-chave-aqui

# Modelos (opcional)
GEMINI_MODEL=gemini-3.8-flash
# Reservas, na ordem. A cota gratuita é por modelo (~20 chamadas/dia cada): quando um
# modelo estoura a cota ou fica sobrecarregado (503), o próximo é usado automaticamente.
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
EMBEDDING_MODEL=gemini-embedding-001

# Banco: SQLite local por padrão. Em produção, use a URL do Postgres.
DATABASE_URL=sqlite:///./data/app.db

# Limite de requisições por IP por minuto no /chat
RATE_LIMIT_PER_MIN=20
